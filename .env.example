# Copy to .env.local for local development. Never commit real values.
# Variables without the NEXT_PUBLIC_ prefix are server-only.

# Gemini API key used by /api/ai/* route handlers.
GEMINI_API_KEY=

# Model used for component generation.
GEMINI_MODEL=gemini-3.8-flash

# Directory for shared project snapshots (/s/<id> links). Mount a volume here in production.
SHARES_DIR=.data/shares

# Days a shared link works before it expires.
SHARES_TTL_DAYS=30
